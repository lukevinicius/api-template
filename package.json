{
  "name": "binder-manager-api",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build --compile --minify-syntax --target bun --outfile server src/server.ts",
    "dev": "bun --watch src/server.ts",
    "migrate": "bun --bun drizzle-kit migrate",
    "migrate:prod": "bun src/database/migrate.ts",
    "generate": "bun --bun drizzle-kit generate",
    "start": "bun src/server.ts",
    "test": "bun test",
    "biome:format": "biome format --write src/",
    "biome:fix": "biome lint src/",
    "biome:check": "biome check --write src/",
    "seed": "bun src/database/seed.ts",
    "seed:prod": "bun src/database/seed.prod.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/bun": "^10.76.2",
    "axios": "^1.20.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "latest",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  },
  "module": "src/server.ts"
}
