COMPOSE_PROJECT_NAME=binder-manager

# DEVELOPMENT ENVIRONMENT
DATABASE_URL=postgresql://postgres:docker@localhost:5432/binder-manager-db
SENTRY_DSN=

# AUTH (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-with-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

PORT=3333
# Hosts accepted for uploaded image URLs (comma separated)
FILE_URL_HOSTS=files.edgestore.dev

# Production seed (bun run seed:prod)
SEED_ADMIN_PASSWORD=
